{
  "name": "leaffleet",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/prepare-assets.mjs && node scripts/check.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "check": "node scripts/prepare-assets.mjs && node scripts/check.mjs",
    "test": "node --test cloud/test/*.test.mjs test/*.test.mjs && node test/controller-check.mjs"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}
